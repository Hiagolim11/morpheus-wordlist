{
  "name": "morpheus-wordlist-desktop",
  "version": "1.0.0",
  "description": "Morpheus Wordlist — app desktop (Electron) com visual Apple/3D",
  "main": "main.js",
  "author": "Hiago",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb --win nsis",
    "dist:linux": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hiago.morpheuswordlist",
    "productName": "Morpheus Wordlist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": ["**/*", "!dist/**"],
    "linux": {
      "target": ["deb"],
      "category": "Utility",
      "maintainer": "Hiago",
      "icon": "build/icon.png"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0"]
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
